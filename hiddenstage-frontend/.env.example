# Base URL of the Django API, including the version prefix.
#
# Local development: leave this as the relative default. Vite proxies /api to
# http://127.0.0.1:8000 (see vite.config.ts), which keeps the session cookie and
# CSRF token same-origin.
#
# Vercel/production: a *relative* path cannot work, because /api/v1/* is not served
# by the frontend host. Set the absolute HTTPS origin of the deployed backend:
#   VITE_API_BASE_URL=https://api.your-domain.com/api/v1
#
# Every VITE_* value is compiled into the public bundle. Never put a secret,
# database URL or API key here.
VITE_API_BASE_URL=/api/v1
