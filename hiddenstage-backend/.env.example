# Copy to .env and fill values. Never commit .env.
# Development defaults are unsafe for production; set DJANGO_DEBUG=0 and real values when deploying.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL (Authoritative cloud database platform).
# Connect to Neon using pooled connection for application server (Gunicorn/ASGI)
# and direct unpooled connection for migrations. Credentials must come from environment.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<dbname>?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<dbname>?channel_binding=require&sslmode=require"
NEON_BRANCH=production
NEON_BRANCH_ID=br-<branch-id>
NEON_FUNCTION_HOST_SUFFIX=.compute.<region>.aws.neon.tech

# Local PostgreSQL fallback (used when DATABASE_URL is unset, or for isolated automated test runs).
POSTGRES_DB=hiddenstage
POSTGRES_USER=hiddenstage
POSTGRES_PASSWORD=hiddenstage
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=
# Optional dedicated isolated test database URL (prevents test runner from touching shared DB)
TEST_DATABASE_URL=

# Exact browser origins allowed to send credentialed requests. Comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hiddenstage.in,https://www.hiddenstage.in
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hiddenstage.in,https://www.hiddenstage.in,https://*.hiddenstage.in

# Behind a TLS-terminating proxy, set to 1.
DJANGO_SECURE_SSL_REDIRECT=0

# Transactional email. With RESEND_API_KEY set, Django sends through Resend SMTP.
# Leave EMAIL_BACKEND empty for that automatic selection. Use the console backend for
# local development without an email provider, or set an explicit SMTP backend.
RESEND_API_KEY=
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.com
# Override only when using a non-Resend SMTP relay.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_TIMEOUT=15
# Base URL used to build verification and reset links in emails.
FRONTEND_BASE_URL=http://localhost:5173
# Event attachments are private (D-013). Point this at a persistent disk in
# production: an ephemeral filesystem loses uploads on every redeploy.
# MEDIA_ROOT=/var/lib/hiddenstage/private-media

# Token lifetimes (hours). Values are implementation defaults pending product approval.
EMAIL_VERIFICATION_TTL_HOURS=24
# Whether an account must prove its address before inviting, quoting, accepting or
# using the Manager/Worker network. This launch runs with it off, because
# transactional email is not yet reliable. Registration then issues no token and
# sends no mail, and no account is marked verified. Set to 1 to restore the gate;
# existing accounts that already verified keep their email_verified_at either way.
EMAIL_VERIFICATION_REQUIRED=0
PASSWORD_RESET_TTL_HOURS=1

# Marketplace policy defaults pending product-owner approval.
INVITATION_TTL_DAYS=7
QUOTATION_MAX_VALIDITY_DAYS=90
