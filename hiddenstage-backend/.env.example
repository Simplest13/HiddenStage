# Copy to .env and fill values. Never commit .env.
# Development defaults are unsafe for production; set DJANGO_DEBUG=0 and real values when deploying.

DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL is authoritative. No SQLite fallback is configured.
POSTGRES_DB=hiddenstage
POSTGRES_USER=hiddenstage
POSTGRES_PASSWORD=hiddenstage
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Required for production hosts that set the database SSL mode; empty means driver default.
POSTGRES_SSLMODE=

# Exact browser origins allowed to send credentialed requests. Comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Behind a TLS-terminating proxy, set to 1.
DJANGO_SECURE_SSL_REDIRECT=0

# Transactional email delivery is not yet decided; console backend is development only.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@hiddenstage.local
# Base URL used to build verification and reset links in emails.
FRONTEND_BASE_URL=http://localhost:5173

# Token lifetimes (hours). Values are implementation defaults pending product approval.
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# Marketplace policy defaults pending product-owner approval.
INVITATION_TTL_DAYS=7
QUOTATION_MAX_VALIDITY_DAYS=90
